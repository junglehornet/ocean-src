package time;

// Nanosecond-based units. Ocean has no const declarations yet; treat these
// exported integer bindings as constants and do not assign to them.
Nanosecond: int = 1;
Microsecond: int = 1000;
Millisecond: int = 1000000;
Second: int = 1000000000;

struct timespec { seconds int; nanoseconds int; }

// Sleep accepts nanoseconds. Nonpositive durations return immediately.
// Short native waits provide cancellation checkpoints in threaded programs,
// without introducing a dependency on the native threading runtime.
func Sleep(nanoseconds int) {
    for (left := nanoseconds; left > 0;) {
        count := left > 50000000 ? 50000000 : left;
        requested := timespec{0, count};
        remaining: timespec;
        for (;;) {
            request: *void = &requested;
            rest: *void = &remaining;
            // Relative Windows due times are negative counts of 100ns ticks.
            ticks := -((requested.nanoseconds + 99) / 100);
            status := -4096;
            asm x86_64/linux {
                mov eax, 35
                mov rdi, ${request}
                mov rsi, ${rest}
                syscall
                mov ${status}, rax
            }
            asm aarch64/linux {
                ldr x0, ${request}
                ldr x1, ${rest}
                mov x8, #101
                svc #0
                str x0, ${status}
            }
            asm riscv64/linux {
                ld a0, ${request}
                ld a1, ${rest}
                li a7, 101
                ecall
                sd a0, ${status}
            }
            asm x86_64/macos {
                mov rdi, ${request}
                mov rsi, ${rest}
                sub rsp, 16
                call _nanosleep
                test eax, eax
                jz 1f
                call ___error
                mov eax, dword ptr [rax]
                neg eax
                1:
                movsxd rax, eax
                add rsp, 16
                mov ${status}, rax
            }
            asm aarch64/macos {
                ldr x19, ${request}
                ldr x20, ${rest}
                sub sp, sp, #64
                stp x9, x10, [sp]
                stp x11, x12, [sp, #16]
                stp x13, x14, [sp, #32]
                str x15, [sp, #48]
                mov x0, x19
                mov x1, x20
                bl _nanosleep
                cbz w0, 1f
                bl ___error
                ldr w0, [x0]
                neg w0, w0
                1:
                sxtw x21, w0
                ldp x9, x10, [sp]
                ldp x11, x12, [sp, #16]
                ldp x13, x14, [sp, #32]
                ldr x15, [sp, #48]
                add sp, sp, #64
                str x21, ${status}
            }
            asm x86_64/windows {
                mov r13, ${ticks}
                sub rsp, 80
                xor ecx, ecx
                mov edx, 1
                xor r8d, r8d
                call CreateWaitableTimerW
                mov r12, rax
                test rax, rax
                jz 3f
                mov qword ptr [rsp + 64], r13
                mov rcx, r12
                lea rdx, [rsp + 64]
                xor r8d, r8d
                xor r9d, r9d
                mov qword ptr [rsp + 32], 0
                mov qword ptr [rsp + 40], 0
                call SetWaitableTimer
                mov r14, -1
                test eax, eax
                jz 2f
                mov rcx, r12
                mov edx, -1
                call WaitForSingleObject
                test eax, eax
                jnz 2f
                xor r14d, r14d
                2:
                mov rcx, r12
                call CloseHandle
                test eax, eax
                jnz 4f
                3: mov r14, -1
                4:
                add rsp, 80
                mov ${status}, r14
            }
            asm aarch64/windows {
                ldr x19, ${ticks}
                sub sp, sp, #80
                stp x9, x10, [sp]
                stp x11, x12, [sp, #16]
                stp x13, x14, [sp, #32]
                str x15, [sp, #48]
                mov x0, #0
                mov w1, #1
                mov x2, #0
                bl CreateWaitableTimerW
                mov x20, x0
                mov x21, #-1
                cbz x0, 3f
                str x19, [sp, #64]
                mov x0, x20
                add x1, sp, #64
                mov w2, #0
                mov x3, #0
                mov x4, #0
                mov w5, #0
                bl SetWaitableTimer
                cbz w0, 2f
                mov x0, x20
                mov w1, #-1
                bl WaitForSingleObject
                cbnz w0, 2f
                mov x21, #0
                2:
                mov x0, x20
                bl CloseHandle
                cbnz w0, 3f
                mov x21, #-1
                3:
                ldp x9, x10, [sp]
                ldp x11, x12, [sp, #16]
                ldp x13, x14, [sp, #32]
                ldr x15, [sp, #48]
                add sp, sp, #80
                str x21, ${status}
            }
            if (status == 0) break;
            if (status == -4) { requested = remaining; continue; }
            if (status == -4096) panic "time.Sleep is unsupported on this architecture/platform";
            panic "native sleep failed";
        }
        left -= count;
    }
}
