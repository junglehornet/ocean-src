package io;

// Strict signed decimal parsing, including the complete signed 64-bit range.
func ParseInt(text string) Result<int> {
    if (len(text) == 0) return Result<int>.error("invalid integer");
    index := 0;
    negative := text[0] == '-';
    if (text[0] == '-' || text[0] == '+') index++;
    if (index == len(text)) return Result<int>.error("invalid integer");
    limit := negative ? (-9223372036854775807 - 1) : -9223372036854775807;
    cutoff := limit / 10;
    value := 0;
    for (; index < len(text); index++) {
        character := text[index];
        if (character < '0' || character > '9') return Result<int>.error("invalid integer");
        digit := (character - '0')->int;
        if (value < cutoff) return Result<int>.error("integer out of range");
        value *= 10;
        if (value < limit + digit) return Result<int>.error("integer out of range");
        value -= digit;
    }
    return Result<int>.value(negative ? value : -value);
}

func parseFloatFromBits(bits uint) float {
    raw: *void = &bits;
    return *(raw -> (*float));
}
func parseFloatWord(text string, start int, word string) bool {
    if (len(text) - start != len(word)) return false;
    for (i := 0; i < len(word); i++) {
        character := text[start + i];
        if (character >= 'A' && character <= 'Z') character += 32;
        if (character != word[i]) return false;
    }
    return true;
}

// Compare exact decimal values: digits * 10^exponent vs midpoint * 10^-scale.
func compareParsedDecimal(digits string, exponent int, midpoint string, scale int) int {
    leftPower := len(digits) + exponent;
    rightPower := len(midpoint) - scale;
    if (leftPower != rightPower) return leftPower < rightPower ? -1 : 1;
    length := len(digits) > len(midpoint) ? len(digits) : len(midpoint);
    for (i := 0; i < length; i++) {
        left := i < len(digits) ? digits[i] : '0';
        right := i < len(midpoint) ? midpoint[i] : '0';
        if (left != right) return left < right ? -1 : 1;
    }
    return 0;
}

// Base-1e9 limbs and chunked powers avoid digit-by-digit multiplication for
// extreme exponents. Every intermediate stays below signed 64-bit overflow.
func parseFloatDecimal(mantissa uint, exponent int) (string, int) {
    limbs := int[]{};
    for (; mantissa > 0; mantissa /= 1000000000) limbs.append((mantissa % 1000000000)->int);
    if (len(limbs) == 0) limbs.append(0);
    negative := exponent < 0;
    remaining := negative ? -exponent : exponent;
    stride := negative ? 12 : 29;
    for (; remaining > 0;) {
        factor := negative ? 244140625 : 536870912;
        steps := remaining > stride ? stride : remaining;
        if (steps < stride) {
            factor = 1;
            for (i := 0; i < steps; i++) factor *= negative ? 5 : 2;
        }
        carry := 0;
        for (i := 0; i < len(limbs); i++) {
            product := limbs[i] * factor + carry;
            limbs[i] = product % 1000000000;
            carry = product / 1000000000;
        }
        if (carry > 0) limbs.append(carry);
        remaining -= steps;
    }
    bytes := i8[]{};
    for (i := len(limbs) - 1; i >= 0; i--) {
        part := sprintInt(limbs[i]);
        if (i < len(limbs) - 1) {
            for (pad := len(part); pad < 9; pad++) bytes.append('0');
        }
        for (j := 0; j < len(part); j++) bytes.append(part[j]);
    }
    return bytes -> string, negative ? -exponent : 0;
}

// Exact midpoint between adjacent positive binary64 encodings (also 0/minsubnormal
// and max-finite/the overflow threshold), avoiding rounded float arithmetic.
func parseFloatMidpoint(lower uint) (string, int) {
    exponentBits := ((lower >> 52) & 2047)->int;
    mantissa := lower & 4503599627370495;
    exponent := -1074;
    if (exponentBits != 0) {
        mantissa |= 4503599627370496;
        exponent = exponentBits - 1075;
    }
    return parseFloatDecimal(mantissa * 2 + 1, exponent - 1);
}

func ParseFloat(text string) Result<float> {
    if (len(text) == 0) return Result<float>.error("invalid float");
    index := 0;
    negative := text[0] == '-';
    if (text[0] == '-' || text[0] == '+') index++;
    if (index == len(text)) return Result<float>.error("invalid float");
    sign := negative ? ((1->uint) << 63) : 0->uint;
    if (parseFloatWord(text, index, "nan"))
        return Result<float>.value(parseFloatFromBits((9221120237041090560->uint) | sign));
    if (parseFloatWord(text, index, "inf") || parseFloatWord(text, index, "infinity"))
        return Result<float>.value(parseFloatFromBits((9218868437227405312->uint) | sign));
    bytes := i8[]{};
    point := false;
    fraction := 0;
    for (; index < len(text); index++) {
        character := text[index];
        if (character >= '0' && character <= '9') {
            bytes.append(character);
            if (point) fraction++;
        } else if (character == '.' && !point) point = true;
        else break;
    }
    if (len(bytes) == 0) return Result<float>.error("invalid float");
    exponent := 0;
    if (index < len(text) && (text[index] == 'e' || text[index] == 'E')) {
        index++;
        exponentNegative := false;
        if (index < len(text) && (text[index] == '+' || text[index] == '-')) {
            exponentNegative = text[index] == '-'; index++;
        }
        start := index;
        limit := len(text) + 1024;
        for (; index < len(text); index++) {
            character := text[index];
            if (character < '0' || character > '9') break;
            digit := (character - '0')->int;
            if (exponent < limit) {
                if (exponent > (limit - digit) / 10) exponent = limit;
                else exponent = exponent * 10 + digit;
            }
        }
        if (index == start) return Result<float>.error("invalid float");
        if (exponentNegative) exponent = -exponent;
    }
    if (index != len(text)) return Result<float>.error("invalid float");
    first := 0;
    for (; first < len(bytes) && bytes[first] == '0'; first++) {}
    if (first == len(bytes)) return Result<float>.value(parseFloatFromBits(sign));
    magnitude := len(bytes) - first - 1 + exponent - fraction;
    if (magnitude > 308) return Result<float>.error("float out of range");
    if (magnitude < -324) return Result<float>.value(parseFloatFromBits(sign));
    last := len(bytes);
    for (; last > first + 1 && bytes[last - 1] == '0'; last--) {}
    exponent += len(bytes) - last - fraction;
    significant := i8[]{};
    for (i := first; i < last; i++) significant.append(bytes[i]);
    digits := significant -> string;
    take := len(digits) > 17 ? 17 : len(digits);
    prefix := 0->uint;
    for (i := 0; i < take; i++) prefix = prefix * 10 + ((digits[i] - '0')->uint);
    approximate := prefix -> float;
    power := exponent + len(digits) - take;
    for (; power >= 100; power -= 100) approximate *= 1e100;
    for (; power <= -100; power += 100) approximate /= 1e100;
    factor := 1.0;
    count := power < 0 ? -power : power;
    for (i := 0; i < count; i++) factor *= 10.0;
    approximate = power < 0 ? approximate / factor : approximate * factor;
    raw: *void = &approximate;
    candidate := *(raw -> (*uint));
    maximum := 9218868437227405311->uint;
    if (candidate > maximum) candidate = maximum;
    for (;;) {
        odd := (candidate & 1) != 0;
        if (candidate > 0) {
            low, scale := parseFloatMidpoint(candidate - 1);
            comparison := compareParsedDecimal(digits, exponent, low, scale);
            if (comparison < 0 || (comparison == 0 && odd)) { candidate--; continue; }
        }
        high, scale := parseFloatMidpoint(candidate);
        comparison := compareParsedDecimal(digits, exponent, high, scale);
        if (comparison > 0 || (comparison == 0 && odd)) {
            if (candidate == maximum) return Result<float>.error("float out of range");
            candidate++;
            continue;
        }
        return Result<float>.value(parseFloatFromBits(candidate | sign));
    }
}
