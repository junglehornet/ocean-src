package exec;

// This narrow ABI is implemented by the matching compiler's embedded native
// process runtime. The public command API and all validation remain in Ocean.
struct nativeCommand {
    path buffer<i8>;
    argv *void;
    directory buffer<i8>;
    environment *void;
    capture int;
    combined int;
    exitCode int;
    output buffer<i8>;
    outputSize int;
    error buffer<i8>;
}
extern i32 ocean_process_run(*nativeCommand command);
extern buffer<i8> ocean_process_lookpath(buffer<i8> name);
extern void free(*void pointer);

struct Cmd { Path string; Args string[]; Dir string; Env string[]; ExitCode int; used bool; }
func Command(name string, args ...string) Cmd { c: Cmd; c.Path = name; c.Args = args; c.ExitCode = -1; return c; }
func clean(text string) bool {
    for (_, c := range text) { if (c == 0) return false; }
    return true;
}
func copyCString(raw buffer<i8>) string {
    bytes := i8[]{};
    if ((raw -> int) != 0) { for (i := 0; raw[i] != 0; i++) bytes.append(raw[i]); }
    return bytes -> string;
}
func (c *Cmd) execute(capture bool, combined bool) Result<string> {
    if (c.used) return Result<string>.error("exec: command already started");
    c.used = true;
    c.ExitCode = -1;
    if (c.Path == "" || !clean(c.Path)) return Result<string>.error("exec: invalid executable");
    if (!clean(c.Dir)) return Result<string>.error("exec: directory contains NUL");
    storage := i8[][]{(c.Path + "\0") -> i8[]};
    for (_, arg := range c.Args) {
        if (!clean(arg)) return Result<string>.error("exec: argument contains NUL");
        storage.append((arg + "\0") -> i8[]);
    }
    argv := int[]{};
    for (i := 0; i < len(storage); i++) argv.append(storage[i].data -> int);
    argv.append(0);
    envStorage := i8[][]{};
    for (_, entry := range c.Env) {
        if (!clean(entry)) return Result<string>.error("exec: environment contains NUL");
        if (len(entry) == 0 || entry[0] == '=') return Result<string>.error("exec: environment name is empty");
        equals := false;
        for (i := 1; i < len(entry); i++) { if (entry[i] == '=') equals = true; }
        if (!equals) return Result<string>.error("exec: environment entry requires NAME=value");
        envStorage.append((entry + "\0") -> i8[]);
    }
    envPointers := int[]{};
    for (i := 0; i < len(envStorage); i++) envPointers.append(envStorage[i].data -> int);
    envPointers.append(0);
    directory := (c.Dir + "\0") -> i8[];
    native: nativeCommand;
    native.path = storage[0].data;
    native.argv = argv.data -> (*void);
    native.directory = directory.data;
    native.environment = len(c.Env) == 0 ? zero(*void) : envPointers.data -> (*void);
    native.capture = capture ? 1 : 0;
    native.combined = combined ? 1 : 0;
    native.output = zero(buffer<i8>);
    native.error = zero(buffer<i8>);
    native.exitCode = -1;
    code := extern.ocean_process_run(&native);
    c.ExitCode = native.exitCode;
    bytes := i8[]{};
    if ((native.output -> int) != 0) {
        defer extern.free(native.output -> (*void));
        chunk: i8[4096];
        for (offset := 0; offset < native.outputSize;) {
            count := native.outputSize - offset; if (count > 4096) count = 4096;
            for (i := 0; i < count; i++) chunk[i] = native.output[offset+i];
            bytes.append(chunk[:count]...); offset += count;
        }
    }
    if (code != 0) return Result<string>.error(copyCString(native.error));
    return Result<string>.value(bytes -> string);
}
func (c *Cmd) Run() Result<int> {
    result := c.execute(false, false);
    if (result.hasError()) return Result<int>.error(result.error());
    return Result<int>.value(c.ExitCode);
}
func (c *Cmd) Output() Result<string> { return c.execute(true, false); }
func (c *Cmd) CombinedOutput() Result<string> { return c.execute(true, true); }

func LookPath(name string) Result<string> {
    if (name == "" || !clean(name)) return Result<string>.error("exec: invalid executable");
    input := (name + "\0") -> i8[];
    result := extern.ocean_process_lookpath(input.data);
    if ((result -> int) == 0) return Result<string>.error("exec: executable not found or resolves relative to current directory");
    defer extern.free(result -> (*void));
    return Result<string>.value(copyCString(result));
}
