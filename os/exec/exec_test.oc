package exec;
import "testing";
import "time";
func windows() bool { result := 0; asm x86_64/windows { mov qword ptr ${result}, 1 } asm aarch64/windows { mov x0, #1; str x0, ${result} } return result != 0; }
func TestOutput(t *testing.T) {
    if (windows()) { t.Skip("POSIX utility fixture; native Windows coverage below"); return; }
    c := Command("printf", "%s|%s", "a b", "$(echo injected)");
    if (c.Output().unwrap() != "a b|$(echo injected)" || c.ExitCode != 0) t.Fatal("argument preservation");
    if (!c.Run().hasError()) t.Fatal("command reused");
}
func TestCombinedOutput(t *testing.T) {
    if (windows()) { t.Skip("POSIX utility fixture; native Windows coverage below"); return; }
    c := Command("/bin/sh", "-c", "printf out; printf err >&2");
    if (c.CombinedOutput().unwrap() != "outerr") t.Fatal("combined streams");
}
func TestExitAndErrors(t *testing.T) {
    if (windows()) { t.Skip("POSIX utility fixture; native Windows coverage below"); return; }
    c := Command("/bin/sh", "-c", "exit 7");
    if (!c.Run().hasError() || c.ExitCode != 7) t.Fatal("exit status");
    missing := Command("/definitely/no/executable");
    if (!missing.Output().hasError()) t.Fatal("missing executable");
    bad := Command("printf", "a\0b");
    if (!bad.Run().hasError()) t.Fatal("NUL accepted");
    ok := Command("/bin/true"); if (ok.Run().unwrap() != 0) t.Fatal("Run");
}
func TestLargeOutput(t *testing.T) {
    if (windows()) { t.Skip("POSIX utility fixture; native Windows coverage below"); return; }
    c := Command("head", "-c", "160000", "/dev/zero");
    if (len(c.Output().unwrap()) != 160000) t.Fatal("large output truncated or blocked");
}
func TestDirectoryAndEnvironment(t *testing.T) {
    if (windows()) { t.Skip("POSIX utility fixture; native Windows coverage below"); return; }
    c := Command("/bin/sh", "-c", "printf '%s|' \"$OCEAN_EXEC_TEST\"; pwd");
    c.Dir = "/"; c.Env = string[]{"OCEAN_EXEC_TEST=custom"};
    if (c.Output().unwrap() != "custom|/\n") t.Fatal("directory/environment");
    bad := Command("/bin/true"); bad.Dir = "/not/a/real/directory";
    if (!bad.Run().hasError()) t.Fatal("invalid directory");
    badEnv := Command("/bin/true"); badEnv.Env = string[]{"X=bad\0value"};
    if (!badEnv.Run().hasError()) t.Fatal("invalid environment");
}
func TestLookPath(t *testing.T) {
    if (windows()) { t.Skip("POSIX utility fixture; native Windows coverage below"); return; }
    if (LookPath("sh").hasError() || LookPath("/bin/sh").unwrap() != "/bin/sh") t.Fatal("lookup");
    if (!LookPath("/tmp").hasError() || !LookPath("/definitely/not/here").hasError() || !LookPath("").hasError()) t.Fatal("lookup failure");
}

extern buffer<i8> getenv(buffer<i8> name);
func fixtureValue(name string) string {
    key := (name + "\0") -> i8[];
    return copyCString(extern.getenv(key.data));
}
func nativeFixture(t *testing.T) string {
    path := fixtureValue("OCEAN_EXEC_FIXTURE");
    if (path == "") t.Skip("run os/exec/tests/integration.py for native process fixtures");
    return path;
}
func diagnosticOutput(t *testing.T, label string, c *Cmd) string {
    t.Logf("START {}: path={} args={} dir={}", label, c.Path, c.Args, c.Dir);
    start := time.Monotonic(); result := c.Output();
    t.Logf("DONE {}: exit={} elapsed={}ms", label, c.ExitCode, (time.Monotonic()-start)/time.Millisecond);
    if (result.hasError()) t.Fatalf("{} failed: {}", label, result.error());
    output := result.unwrap(); t.Logf("{} captured {} bytes", label, len(output)); return output;
}
func diagnosticRun(t *testing.T, label string, c *Cmd) Result<int> {
    t.Logf("START {}: path={} args={} dir={}", label, c.Path, c.Args, c.Dir);
    start := time.Monotonic(); result := c.Run();
    t.Logf("DONE {}: exit={} elapsed={}ms", label, c.ExitCode, (time.Monotonic()-start)/time.Millisecond);
    if (result.hasError()) t.Logf("{} returned: {}", label, result.error());
    return result;
}
func TestWindowsNativeProcess(t *testing.T) {
    if (!windows()) { t.Skip("native Windows fixture"); return; }
    path := nativeFixture(t);
    command := Command(path, "output");
    if (diagnosticOutput(t, "native output", &command) != "native-output" || command.ExitCode != 0) t.Fatal("native output");
    if (!diagnosticRun(t, "reuse rejection", &command).hasError()) t.Fatal("command reused");
    failed := Command(path, "exit");
    if (!diagnosticRun(t, "exit 7", &failed).hasError() || failed.ExitCode != 7) t.Fatal("native exit code");
    large := Command(path, "large");
    if (len(diagnosticOutput(t, "160000-byte output", &large)) != 160000) t.Fatal("native capture truncated");
    t.Log("START native executable lookup");
    if (LookPath(path).hasError() || !LookPath("ocean-missing-program-908a.exe").hasError()) t.Fatal("native lookup");
    t.Log("DONE native executable lookup");
}
func TestWindowsEnvironmentAndArguments(t *testing.T) {
    if (!windows()) { t.Skip("native Windows fixture"); return; }
    path := nativeFixture(t); directory := fixtureValue("OCEAN_EXEC_FIXTURE_DIR");
    c := Command(path, "args", "a b", "$(echo injected)", "say \"hi\"", "C:\\tail\\", "🌊", "");
    actual := diagnosticOutput(t, "argument preservation", &c);
    if (actual != "a b|$(echo injected)|say \"hi\"|C:\\tail\\|🌊|") t.Fatalf("argument preservation: got {}", actual);
    environment := Command(path, "environment", directory);
    environment.Env = string[]{"OCEAN_EXEC_TEST=custom"}; environment.Dir = directory;
    if (diagnosticOutput(t, "replacement environment and directory", &environment) != "custom|cwd-ok") t.Fatal("native environment/directory");
    bad := Command(path); bad.Dir = directory + "/ocean-no-such-directory";
    if (!diagnosticRun(t, "invalid directory rejection", &bad).hasError()) t.Fatal("invalid native directory");
}

func TestRejectEmptyEnvironmentNames(t *testing.T) {
    for (_, entry := range string[]{"", "=value", "=value=again", "NO_EQUALS"}) {
        command := Command("ocean-not-executed"); command.Env = string[]{entry};
        result := command.Run();
        if (!result.hasError() || command.ExitCode != -1) t.Fatal("invalid environment accepted");
        if (result.error() != "exec: environment name is empty" && result.error() != "exec: environment entry requires NAME=value") t.Fatal("environment was not validated before spawn");
    }
}
