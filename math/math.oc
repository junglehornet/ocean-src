package math;

// Constant by convention: Ocean does not yet have const declarations.
Pi: float = 3.14159265358979323846264338327950288;
E: float = 2.71828182845904523536028747135266250;
Ln2: float = 0.693147180559945309417232121458176568;
Sqrt2: float = 1.41421356237309504880168872420969808;

func Float64bits(x float) uint {
    raw: *void = &x;
    return *(raw -> (*uint));
}
func Float64frombits(bits uint) float {
    raw: *void = &bits;
    return *(raw -> (*float));
}
func NaN() float { return Float64frombits(9221120237041090560); }
func Inf(sign int) float {
    return Float64frombits(sign < 0 ? 18442240474082181120 : 9218868437227405312);
}
func IsNaN(x float) bool { return x != x; }
func IsInf(x float, sign int) bool {
    return (sign >= 0 && x == Inf(1)) || (sign <= 0 && x == Inf(-1));
}
func Signbit(x float) bool { return (Float64bits(x) >> 63) != 0; }
func Abs(x float) float { return Float64frombits(Float64bits(x) & 9223372036854775807); }
func Copysign(x float, y float) float {
    return Float64frombits((Float64bits(x) & 9223372036854775807) | (Float64bits(y) & 9223372036854775808));
}
func Trunc(x float) float {
    bits := Float64bits(x);
    exponent := ((bits >> 52) & 2047) -> int;
    if (exponent < 1023) return Copysign(0.0, x);
    if (exponent >= 1075) return x;
    mask: uint = (1 -> uint) << ((1075 - exponent) -> uint);
    return Float64frombits(bits & ~(mask - 1));
}
func Floor(x float) float { y := Trunc(x); return x < y ? y - 1.0 : y; }
func Ceil(x float) float { y := Trunc(x); return x > y ? y + 1.0 : y; }
// Round rounds halfway cases away from zero.
func Round(x float) float {
    y := Trunc(x);
    if (Abs(x - y) >= 0.5) return y + Copysign(1.0, x);
    return y;
}
func Min(x float, y float) float {
    if (IsNaN(x) || IsNaN(y)) return NaN();
    if (x == y && Signbit(x)) return x;
    return x < y ? x : y;
}
func Max(x float, y float) float {
    if (IsNaN(x) || IsNaN(y)) return NaN();
    if (x == y && Signbit(x)) return y;
    return x > y ? x : y;
}
// Mod uses truncating division; its result has x's sign.
func Mod(x float, y float) float {
    if (IsNaN(x) || IsNaN(y) || IsInf(x, 0) || y == 0) return NaN();
    a := Abs(x); b := Abs(y);
    if (a < b || IsInf(b, 0)) return x;
    // Binary long division avoids overflowing x/y or converting it to int.
    step := b;
    for (step <= a / 2.0) step *= 2.0;
    for (step >= b) {
        if (a >= step) a -= step;
        step *= 0.5;
        if (step == 0) break;
    }
    return Copysign(a, x);
}
func scale(x float, exponent int) float {
    // Scale in normal factors so the final multiplication rounds subnormals.
    for (exponent > 1023) { x *= 8.98846567431158e307; exponent -= 1023; }
    for (exponent < -1022) { x *= 2.2250738585072014e-308; exponent += 1022; }
    factor := Float64frombits(((exponent + 1023) -> uint) << 52);
    return x * factor;
}
func Exp(x float) float {
    if (IsNaN(x)) return x;
    if (x > 709.782712893384) return Inf(1);
    if (x < -745.1332191019412) return 0.0;
    n := Round(x / 0.6931471805599453) -> int;
    r := (x - n * 0.6931471803691238) - n * 1.9082149292705877e-10;
    term := 1.0; sum := 1.0;
    for (k := 1; k <= 18; k++) { term *= r / k; sum += term; }
    return scale(sum, n);
}
func Exp2(x float) float {
    if (IsNaN(x)) return x;
    if (x >= 1024) return Inf(1);
    if (x <= -1075) return 0.0;
    n := Round(x) -> int;
    return scale(Exp((x - n) * 0.6931471805599453), n);
}
func Log(x float) float {
    if (IsNaN(x) || x < 0) return NaN();
    if (x == 0) return Inf(-1);
    if (IsInf(x, 1)) return x;
    offset := 0;
    if (x < 2.2250738585072014e-308) { x *= 4503599627370496.0; offset = -52; }
    bits := Float64bits(x);
    exponent := (((bits >> 52) & 2047) -> int) - 1023 + offset;
    m := Float64frombits((bits & 4503599627370495) | 4607182418800017408);
    if (m > 1.4142135623730951) { m *= 0.5; exponent++; }
    z := (m - 1.0) / (m + 1.0); z2 := z * z;
    term := z; sum := z;
    for (k := 3; k <= 39; k += 2) { term *= z2; sum += term / k; }
    return exponent * 0.6931471805599453 + 2.0 * sum;
}
func Log2(x float) float { return Log(x) / 0.6931471805599453; }
func Log10(x float) float { return Log(x) / 2.302585092994046; }

func positivePow(x float, y float) float {
    result := 0.0;
    native := false;
    // x87 computes y*log2(x), then splits its exponent for f2xm1/fscale.
    // The stack is balanced; no C ABI calls or CPU extensions are required.
    asm x86_64 {
        fld qword ptr ${y}
        fld qword ptr ${x}
        fyl2x
        fld st(0)
        frndint
        fxch st(1)
        fsub st(0), st(1)
        f2xm1
        fld1
        faddp st(1), st(0)
        fscale
        fstp st(1)
        fstp qword ptr ${result}
        mov byte ptr ${native}, 1
    }
    if (native) return result;
    return Exp(y * Log(x));
}
func Pow(x float, y float) float {
    if (y == 0 || x == 1) return 1.0;
    if (IsNaN(x) || IsNaN(y)) return NaN();
    a := Abs(x);
    if (IsInf(y, 0)) {
        if (a == 1) return 1.0;
        if ((a > 1) == (y > 0)) return Inf(1);
        return 0.0;
    }
    odd := Abs(y) < 9007199254740992.0 && Mod(Abs(y), 2.0) == 1;
    negative := Signbit(x) && odd;
    if (a == 0 || IsInf(a, 1)) {
        result := ((a == 0) == (y > 0)) ? 0.0 : Inf(1);
        return negative ? -result : result;
    }
    if (x < 0 && Trunc(y) != y) return NaN();
    if (a == 1) return negative ? -1.0 : 1.0;
    // Handle huge exponents before x87 can produce an infinite intermediate.
    if (Abs(y) > 1.0e19) {
        result := ((a > 1) == (y > 0)) ? Inf(1) : 0.0;
        return negative ? -result : result;
    }
    // Integer powers avoid transcendental work and preserve exact small powers.
    if (Trunc(y) == y && Abs(y) < 2147483648.0) {
        n := Abs(y) -> int;
        base := y < 0 ? 1.0 / a : a;
        result := 1.0;
        for (; n > 0; n >>= 1) {
            if ((n & 1) != 0) result *= base;
            if (n > 1) base *= base;
        }
        return negative ? -result : result;
    }
    result := positivePow(a, y);
    return negative ? -result : result;
}
func Sqrt(x float) float {
    if (x == 0 || IsInf(x, 1)) return x;
    if (x < 0 || IsNaN(x)) return NaN();
    result := 0.0; native := false;
    asm x86_64 {
        movsd xmm0, ${x}
        sqrtsd xmm0, xmm0
        movsd ${result}, xmm0
        mov byte ptr ${native}, 1
    }
    asm aarch64 {
        ldr d0, ${x}
        fsqrt d0, d0
        str d0, ${result}
        mov w0, #1
        strb w0, ${native}
    }
    asm riscv64 {
        fld ft0, ${x}
        fsqrt.d ft0, ft0
        fsd ft0, ${result}
        li t0, 1
        sb t0, ${native}
    }
    if (native) return result;
    // Normalize subnormals before constructing a Newton iteration seed.
    adjust := 1.0;
    if (x < 2.2250738585072014e-308) { x *= 4503599627370496.0; adjust = 1.4901161193847656e-8; }
    result = Float64frombits((Float64bits(x) >> 1) + 2303591209400008704);
    for (i := 0; i < 7; i++) result = 0.5 * (result + x / result);
    return result * adjust;
}
func Hypot(x float, y float) float {
    x = Abs(x); y = Abs(y);
    if (IsInf(x, 1) || IsInf(y, 1)) return Inf(1);
    if (IsNaN(x) || IsNaN(y)) return NaN();
    if (y > x) { temp := x; x = y; y = temp; }
    if (x == 0) return x;
    r := y / x;
    return x * Sqrt(1.0 + r * r);
}

// Radians. Reduction uses binary64 Pi; see README for large-angle accuracy.
func Sin(x float) float {
    if (IsNaN(x) || IsInf(x, 0)) return NaN();
    if (x == 0) return x;
    r := Mod(x, 6.2831853071795864769);
    if (r > 3.141592653589793) r -= 6.283185307179586;
    if (r < -3.141592653589793) r += 6.283185307179586;
    if (r > 1.5707963267948966) r = 3.141592653589793 - r;
    if (r < -1.5707963267948966) r = -3.141592653589793 - r;
    term := r; sum := r;
    for (k := 1; k <= 12; k++) { term *= -r * r / ((2 * k) * (2 * k + 1)); sum += term; }
    return sum;
}
func Cos(x float) float {
    if (IsNaN(x) || IsInf(x, 0)) return NaN();
    r := Abs(Mod(x, 6.2831853071795864769));
    if (r > 3.141592653589793) r = 6.283185307179586 - r;
    sign := 1.0;
    if (r > 1.5707963267948966) { r = 3.141592653589793 - r; sign = -1.0; }
    term := 1.0; sum := 1.0;
    for (k := 1; k <= 12; k++) { term *= -r * r / ((2 * k - 1) * (2 * k)); sum += term; }
    return sign * sum;
}
func Tan(x float) float { return Sin(x) / Cos(x); }
func Atan(x float) float {
    if (IsNaN(x) || x == 0) return x;
    a := Abs(x); reciprocal := a > 1;
    if (reciprocal) a = 1.0 / a;
    offset := 0.0;
    if (a > 0.414213562373095) { a = (a - 1.0) / (a + 1.0); offset = 0.7853981633974483; }
    term := a; sum := a;
    for (k := 1; k <= 24; k++) { term *= -a * a; sum += term / (2 * k + 1); }
    result := offset + sum;
    if (reciprocal) result = 1.5707963267948966 - result;
    return Copysign(result, x);
}
func Atan2(y float, x float) float {
    if (IsNaN(x) || IsNaN(y)) return NaN();
    if (y == 0) return Signbit(x) ? Copysign(3.141592653589793, y) : y;
    if (x == 0) return Copysign(1.5707963267948966, y);
    if (IsInf(y, 0) && IsInf(x, 0)) return Copysign(x > 0 ? 0.7853981633974483 : 2.356194490192345, y);
    angle := Atan(Abs(y / x));
    if (x < 0) angle = 3.141592653589793 - angle;
    return Copysign(angle, y);
}
func Asin(x float) float {
    if (Abs(x) > 1) return NaN();
    return Atan2(x, Sqrt((1.0 - x) * (1.0 + x)));
}
func Acos(x float) float {
    if (Abs(x) > 1) return NaN();
    return Atan2(Sqrt((1.0 - x) * (1.0 + x)), x);
}
