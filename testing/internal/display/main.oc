// Compiler-owned frontend. Test execution stays in a separate process so user
// output and panics cannot interfere with term/tui's ownership of the terminal.
package main;
import "term/tui";
import "time";
import "io";
import "os";

struct pollDescriptor { fd i32; events i16; ready i16; }
extern i32 poll(*pollDescriptor descriptors, uint count, i32 timeout);
extern int read(i32 fd, buffer<i8> data, uint count);
struct clockValue { seconds int; nanos int; }
extern i32 timespec_get(*clockValue value, i32 base);
func now() int {
    value: clockValue;
    extern.timespec_get(&value, 1->i32);
    return value.seconds * 1000000000 + value.nanos;
}
struct chunkMsg { text string; }
struct endMsg {}
struct tickMsg {}
struct clearMsg {}
struct finishMsg {}
func readEvents() tui.Msg {
    descriptor := pollDescriptor{197->i32, 1->i16, 0->i16};
    ready := extern.poll(&descriptor, 1->uint, 50->i32);
    if (ready < 0) return endMsg{};
    if (ready == 0) return chunkMsg{""};
    bytes: i8[4096];
    count := extern.read(197->i32, bytes.data, 4096->uint);
    if (count <= 0) return endMsg{};
    text := i8[]{};
    for (i := 0; i < count; i++) text.append(bytes[i]);
    return chunkMsg{text->string};
}
func split(text string, delimiter i8) string[] {
    result := string[]{};
    word := i8[]{};
    for (i := 0; i < len(text); i++) {
        if (text[i] == delimiter) { result.append(word->string); word = {}; }
        else word.append(text[i]);
    }
    result.append(word->string);
    return result;
}
func unhex(text string) string {
    result := i8[]{};
    for (i := 0; i + 1 < len(text); i += 2) {
        a := text[i]->int; b := text[i + 1]->int;
        a = a >= 'a' ? a - 'a' + 10 : a - '0';
        b = b >= 'a' ? b - 'a' + 10 : b - '0';
        if (a < 0 || a > 15 || b < 0 || b > 15) return "invalid event";
        result.append((a * 16 + b)->i8);
    }
    return result->string;
}
struct testRow { label string; packageRow bool; depth int; name string; status string; output string; start int; elapsed float; }
struct display {
    packageName string;
    color bool;
    showSkipped bool;
    rows testRow[];
    indexes map[string]int;
    pending string;
    packageOutput string;
    width int;
    height int;
    frame int;
    started int;
    finished bool;
    failed bool;
    cancelled bool;
    broken bool;
    cleared bool;
    elapsed float;
    offset int;
    follow bool;
}
func (model *display) Init() tui.Cmd {
    model.started = now();
    return tui.Batch(readEvents, tui.Tick(80 * time.Millisecond, tickMsg{}));
}
// Slash boundaries define ancestry: TestOneMore is not a child of TestOne.
func descendant(name string, parent string) bool {
    boundary := len(parent);
    if (len(name) <= boundary || name[boundary] != '/') return false;
    for (i := 0; i < len(parent); i++) { if (name[i] != parent[i]) return false; }
    return true;
}
func (model *display) insertion(name string) int {
    parent := "";
    position := len(model.rows);
    // Find the nearest known ancestor, including when a subtest's name itself
    // contains slashes without a separately registered intermediate test.
    for (i := 0; i < len(model.rows); i++) {
        candidate := model.rows[i].name;
        if (len(candidate) > len(parent) && descendant(name, candidate)) {
            parent = candidate; position = i + 1;
        }
    }
    if (parent == "") return position;
    for (position < len(model.rows) && descendant(model.rows[position].name, parent)) position++;
    return position;
}
func (model *display) accept(line string) {
    fields := split(line, '\t');
    if (len(fields) != 4 && len(fields) != 5) return;
    action := fields[0];
    if (action == "fail") model.failed = true;
    elapsed := io.ParseFloat(fields[1]).unwrapOrZero();
    name := unhex(fields[2]);
    output := unhex(fields[3]);
    if (action == "done") {
        model.finished = true; model.elapsed = elapsed;
        model.failed = output != "0";
        return;
    }
    label := name;
    packageRow := false;
    depth := 0;
    if (len(fields) == 5) {
        packageKey := fields[4];
        if (packageKey == "") return;
        if (name == "") {
            name = packageKey; label = unhex(packageKey); packageRow = true;
        } else {
            for (i := 0; i < len(label); i++) { if (label[i] == '/') depth++; }
            depth++;
            name = packageKey + "/" + name;
        }
    } else {
        for (i := 0; i < len(name); i++) { if (name[i] == '/') depth++; }
    }
    if (name == "") { if (action == "output") model.packageOutput += output; return; }
    index, present := model.indexes[name];
    if (!present) {
        index = model.insertion(name);
        model.rows.add(index, testRow{name: name, label: label, packageRow: packageRow, depth: depth, status: "run", start: now()});
        for (i := index; i < len(model.rows); i++) { key := model.rows[i].name; model.indexes[key] = i; }
    }
    if (action == "output") model.rows[index].output += output;
    else {
        if (action == "cont") model.rows[index].start = now();
        model.rows[index].status = action;
        model.rows[index].elapsed = elapsed;
    }
}
func (model *display) Update(message tui.Msg) (tui.Model, tui.Cmd) {
    switch (value := message.(type)) {
        case chunkMsg:
            model.pending += value.text;
            lines := split(model.pending, '\n');
            for (i := 0; i + 1 < len(lines); i++) model.accept(lines[i]);
            model.pending = lines[len(lines) - 1];
            if (model.finished) return model, tui.Tick(40 * time.Millisecond, clearMsg{});
            return model, readEvents;
        case tickMsg:
            model.frame++;
            if (!model.finished && !model.cleared) return model, tui.Tick(80 * time.Millisecond, tickMsg{});
        case clearMsg:
            model.cleared = true;
            return model, tui.Tick(10 * time.Millisecond, finishMsg{});
        case finishMsg: return model, tui.Quit;
        case endMsg:
            model.broken = !model.finished;
            model.cleared = true;
            return model, tui.Tick(10 * time.Millisecond, finishMsg{});
        case tui.WindowSizeMsg: model.width = value.Width; model.height = value.Height;
        case tui.KeyMsg:
            if (value.Key == "ctrl+c" || value.Text == "q") {
                model.cancelled = true; model.cleared = true;
                return model, tui.Tick(10 * time.Millisecond, finishMsg{});
            }
            if (value.Key == "up" || value.Key == "pgup") {
                if (model.follow) { model.offset = len(model.rows) - (model.height - 5); if (model.offset < 0) model.offset = 0; }
                model.follow = false;
                model.offset -= value.Key == "pgup" ? 10 : 1;
                if (model.offset < 0) model.offset = 0;
            }
            if (value.Key == "down" || value.Key == "pgdown") {
                model.follow = false; model.offset += value.Key == "pgdown" ? 10 : 1;
            }
            if (value.Key == "end" || value.Text == "f") model.follow = true;
    }
    return model, tui.NoCmd;
}
func repeat(text string, count int) string { result := ""; for (i := 0; i < count; i++) result += text; return result; }
func cells(text string) int {
    count := 0;
    for (i := 0; i < len(text); i++) { byte := text[i]->u8; if (byte < 128 || byte >= 192) count++; }
    return count;
}
func fit(text string, width int) string {
    if (width < 1) return "";
    if (cells(text) <= width) return text + repeat(" ", width - cells(text));
    result := ""; count := 0;
    for (i := 0; i < len(text); i++) {
        byte := text[i]->u8;
        if (byte < 128 || byte >= 192) { if (count >= width - 1) break; count++; }
        result += text[i];
    }
    return result + "…";
}
func (model *display) style(text string, code string) string {
    return model.color && code != "" ? "\x1b[" + code + "m" + text + "\x1b[0m" : text;
}
func (model *display) icon(status string) string {
    if (status == "pass") return model.style("✓", "32");
    if (status == "fail") return model.style("✗", "31");
    if (status == "skip") return model.style("∅", "33");
    if (status == "pause") return model.style("⏸", "36");
    frames := string[8]{"⣾", "⣽", "⣻", "⢿", "⡿", "⣟", "⣯", "⣷"};
    return model.style(frames[model.frame % 8], model.failed ? "31" : "32");
}
func (model *display) View() string {
    if (model.cleared) return "";
    width := model.width > 1 ? model.width - 1 : 79;
    height := model.height > 5 ? model.height : 24;
    counts := int[6]{0, 0, 0, 0, 0, 0};
    packages := 0;
    for (i := 0; i < len(model.rows); i++) {
        if (model.rows[i].packageRow) { packages++; continue; }
        status := model.rows[i].status;
        column := status == "pause" ? 1 : (status == "pass" ? 2 : (status == "fail" ? 3 : (status == "skip" ? 4 : 0)));
        counts[column]++;
    }
    counts[5] = counts[2] + counts[3] + counts[4];
    widths := int[6]{1, 1, 1, 1, 1, 1};
    styles := string[6]{"1;97", "36", "32", "31", "33", ""};
    countText := "";
    countCells := 0;
    for (i := 0; i < 6; i++) {
        widths[i] = len(io.Sprint(counts[i]));
        if (i > 0) { countText += "   "; countCells += 3; }
        number := counts[i] == 0 && i != 5 ? "" : io.Sprint(counts[i]);
        countText += model.style(repeat(" ", widths[i] - len(number)) + number, styles[i]);
        countCells += widths[i];
    }
    elapsed := model.finished ? model.elapsed : ((now() - model.started)->float) / 1000000000.0;
    duration := io.Sprint(elapsed) + "s";
    labelWidth := width - countCells - cells(duration) - 4;
    if (labelWidth < 2) labelWidth = 2;
    state := model.finished ? (model.failed ? "FAILED" : "PASSED") : "(1 packages: 1 running, 0 done)";
    if (packages > 0 && !model.finished) state = "(" + io.Sprint(packages) + " packages)";
    prefix := model.icon(model.finished ? (model.failed ? "fail" : "pass") : "run");
    result := prefix + " " + fit(state, labelWidth - 2) + "  " + countText + "  " + duration + "\n";
    headers := string[6]{"▶", "⏸", "✓", "✗", "∅", "∑"};
    rule := repeat("─", labelWidth + widths[0]) + " " + model.style(headers[0], styles[0]);
    for (i := 1; i < 6; i++) rule += " " + repeat("─", widths[i]) + " " + model.style(headers[i], styles[i]);
    result += rule + " " + repeat("─", cells(duration) + 1) + "\n";
    result += prefix + " " + fit(model.packageName, labelWidth - 2) + "  " + countText + "  " + duration + "\n";
    lines := string[]{};
    folded := "";
    for (i := 0; i < len(model.rows); i++) {
        row := model.rows[i];
        if (row.packageRow) folded = row.status == "pass" || row.status == "fail" || row.status == "skip" ? row.name : "";
        else if (folded != "" && descendant(row.name, folded)) continue;
        if (row.status == "skip" && !model.showSkipped) continue;
        label := row.label == "" ? row.name : row.label;
        depth := row.depth;
        active := row.status == "run" || row.status == "cont" || row.status == "start";
        seconds := active ? row.elapsed + ((now() - row.start)->float) / 1000000000.0 : row.elapsed;
        status := row.status == "pass" ? "--- PASS: " : (row.status == "fail" ? "--- FAIL: " : (row.status == "skip" ? "--- SKIP: " :
            (row.status == "pause" ? "=== PAUSE " : (row.status == "cont" ? "=== CONT  " : "=== RUN   "))));
        text := repeat(" ", depth * 2) + (row.packageRow ? "" : status) + label;
        right := io.Sprint(seconds) + "s";
        if (!active && !row.packageRow && row.status != "pause") right = "(" + right + ")";
        style := row.status == "fail" ? "31" : (row.status == "skip" ? "33" : (row.status == "pause" ? "36" : (active ? "1" : "")));
        if (row.packageRow) {
            values := int[6]{0, 0, 0, 0, 0, 0};
            for (j := 0; j < len(model.rows); j++) {
                child := model.rows[j];
                if (child.packageRow || !descendant(child.name, row.name)) continue;
                column := child.status == "pause" ? 1 : (child.status == "pass" ? 2 : (child.status == "fail" ? 3 : (child.status == "skip" ? 4 : 0)));
                values[column]++;
            }
            values[5] = values[2] + values[3] + values[4];
            columns := "";
            for (j := 0; j < 6; j++) {
                if (j > 0) columns += "   ";
                number := values[j] == 0 && j != 5 ? "" : io.Sprint(values[j]);
                columns += model.style(repeat(" ", widths[j] - len(number)) + number, styles[j]);
            }
            lines.append(model.icon(row.status) + " " + fit(label, labelWidth - 2) + "  " + columns + "  " + right);
        } else {
            lines.append("  " + model.icon(row.status) + " " + model.style(fit(text, width - cells(right) - 6) + "  " + right, style));
        }
        if (row.output != "" && (!row.packageRow || active) && (active || row.status == "fail")) {
            output := split(row.output, '\n');
            last := len(output) - 1;
            if (last > 0 && output[last] == "") last--;
            lines.append("      " + fit(output[last], width - 6));
        }
    }
    if (model.packageOutput != "") {
        output := split(model.packageOutput, '\n');
        last := len(output) - 1; if (last > 0 && output[last] == "") last--;
        lines.append("    " + fit(output[last], width - 4));
    }
    available := height - 4;
    offset := model.follow ? len(lines) - available : model.offset;
    if (offset > len(lines) - available) offset = len(lines) - available;
    if (offset < 0) offset = 0;
    for (i := offset; i < len(lines) && i < offset + available; i++) result += lines[i] + "\n";
    return result + model.style(fit("↑/↓ scroll · f follow · q/Ctrl+C stop", width), "2");
}
func main() int {
    args := os.Args();
    if (len(args) != 4) return 2;
    model := display{packageName: args[1], color: args[2] == "1", showSkipped: args[3] == "1", width: 80, height: 24, follow: true};
    program := tui.NewProgram(&model);
    result := program.Run();
    if (result == Result<tui.Model>.error) { io.Println("ocean test: live display: ", result.(Result<tui.Model>.error)); return 2; }
    return model.cancelled ? 130 : (model.broken ? 2 : 0);
}
