package testing;
import "io";
import "threads";
import "sync";
import "os";
import "time";

// Each package starts tests serially. Parallel marks and parks the calling
// test until its parent serial phase ends. Execution slots are compiler-owned
// and shared between every package selected by a single ocean test command.
type cleanupCallback = func();
struct childTask { id int; test *T; }
struct testJob { name string; callback func(*T); }
struct T {
    gate sync.Mutex;
    parent *T;
    pending childTask[];
    cleaning bool;
    signaled bool;
    parallel bool;
    childrenReady bool;
    slot bool;
    paused int;
    started int;
    owner int;
    name string;
    failed bool;
    skipped bool;
    cleanups cleanupCallback[];
    children string[];
}
struct clockValue { seconds int; nanos int; }
extern i32 timespec_get(*clockValue value, i32 base);
extern int read(i32 fd, buffer<i8> bytes, uint count);
extern int write(i32 fd, buffer<i8> bytes, uint count);
lock: sync.Mutex;
failures: int;
testNames: string[];
poolGate: sync.Mutex;
jobs: testJob[];
workerCount: int;
serialDone: bool;

func now() int {
    value: clockValue;
    extern.timespec_get(&value, 1->i32);
    return value.seconds * 1000000000 + value.nanos;
}
func quote(text string) string {
    result := "\"";
    hex := "0123456789abcdef";
    for (i := 0; i < len(text); i++) {
        c := text[i];
        if (c == '"') result += "\\\"";
        else if (c == '\\') result += "\\\\";
        else if (c == '\n') result += "\\n";
        else if (c == '\r') result += "\\r";
        else if (c == '\t') result += "\\t";
        else if (c >= 0 && c < 32) {
            result += "\\u00";
            result += hex[(c->int) / 16];
            result += hex[(c->int) % 16];
        } else result += c;
    }
    return result + "\"";
}
func duration(elapsed int) string {
    if (elapsed < 0) elapsed = 0;
    fraction := io.Sprint(elapsed % 1000000000);
    for (len(fraction) < 9) fraction = "0" + fraction;
    return io.Sprint(elapsed / 1000000000) + "." + fraction;
}
func event(action string, name string, output string, elapsed int) {
    text := "{\"Action\":" + quote(action) + ",\"Test\":" + quote(name) +
        ",\"Output\":" + quote(output) + ",\"Elapsed\":" + duration(elapsed) + "}\n";
    lock.Lock();
    defer lock.Unlock();
    bytes := text->i8[];
    for (offset := 0; offset < len(bytes);) {
        n := extern.write(198->i32, (&bytes[offset])->(buffer<i8>), (len(bytes) - offset)->uint);
        if (n <= 0) panic "test event stream closed";
        offset += n;
    }
}
func (t *T) Name() string { return t.name; }
func (t *T) Failed() bool {
    t.gate.Lock(); defer t.gate.Unlock(); return t.failed;
}
func (t *T) Skipped() bool {
    t.gate.Lock(); defer t.gate.Unlock(); return t.skipped;
}
func (t *T) Fail() { t.gate.Lock(); t.failed = true; t.gate.Unlock(); }
func (t *T) Log(items ...any) { event("output", t.name, io.Sprint(items...) + "\n", 0); }
func (t *T) Logf(format string, items ...any) { t.Log(io.Sprintf(format, items...).unwrap()); }
func (t *T) Error(items ...any) { t.Fail(); t.Log(items...); }
func (t *T) Errorf(format string, items ...any) { t.Fail(); t.Logf(format, items...); }
func (t *T) FailNow() { t.Fail(); threads.Return(); }
func (t *T) Fatal(items ...any) { t.Error(items...); threads.Return(); }
func (t *T) Fatalf(format string, items ...any) { t.Errorf(format, items...); threads.Return(); }
func (t *T) SkipNow() {
    t.gate.Lock(); t.skipped = true; t.gate.Unlock(); threads.Return();
}
func (t *T) Skip(items ...any) { t.Log(items...); t.SkipNow(); }
func (t *T) Skipf(format string, items ...any) { t.Logf(format, items...); t.SkipNow(); }
func (t *T) Cleanup(callback func()) {
    t.gate.Lock(); t.cleanups.append(callback); t.gate.Unlock();
}
func (t *T) Helper() { }
func runCleanups(t *T) {
    t.gate.Lock();
    if (len(t.cleanups) == 0) { t.gate.Unlock(); return; }
    last := len(t.cleanups) - 1;
    cleanup := t.cleanups[last];
    t.cleanups.remove(last);
    t.gate.Unlock();
    defer runCleanups(t);
    cleanup();
}
func clean(t *T) {
    t.gate.Lock(); t.cleaning = true; t.gate.Unlock();
    defer func() {
        message := recover();
        if (message != null) t.Error("panic: ", message);
    }();
    runCleanups(t);
}
func acquire(t *T) {
    event("acquire", "", "", 0);
    byte: i8[1];
    for (extern.read(199->i32, byte.data, 1->uint) != 1) time.Sleep(time.Millisecond);
    t.slot = true;
}
func release(t *T) {
    if (t.slot) { t.slot = false; event("release", "", "", 0); }
}
func releaseChild(child childTask) { threads.Await(child.id); free(child.test); }
func finish(t *T) {
    t.gate.Lock(); t.childrenReady = true; hasChildren := len(t.pending) > 0; t.gate.Unlock();
    if (hasChildren) release(t);
    for (;;) {
        t.gate.Lock();
        if (len(t.pending) == 0) { t.gate.Unlock(); break; }
        last := len(t.pending) - 1; child := t.pending[last]; t.pending.remove(last);
        t.gate.Unlock(); releaseChild(child);
    }
    if (!t.slot) acquire(t);
    clean(t);
}
func report(t *T, start int) {
    failed := t.Failed();
    if (failed) {
        if (t.parent != null) t.parent.Fail();
        else { poolGate.Lock(); failures++; poolGate.Unlock(); }
    }
    event(failed ? "fail" : (t.Skipped() ? "skip" : "pass"), t.name, "", now() - start - t.paused);
    t.gate.Lock(); t.signaled = true; t.gate.Unlock();
}
func execute(t *T, callback func(*T)) {
    acquire(t);
    t.owner = threads.CurrentID();
    start := now(); t.started = start;
    event("run", t.name, "", 0);
    // Separate deferred frames preserve reporting if a cleanup itself stops
    // the current thread. A panic fails this test without terminating the pool.
    defer release(t);
    defer report(t, start);
    defer finish(t);
    defer func() {
        message := recover();
        if (message != null) t.Error("panic: ", message);
    }();
    callback(t);
}
func (t *T) newChild(name string) *T {
    t.gate.Lock();
    if (t.cleaning) {
        t.gate.Unlock(); t.Error("cannot start a subtest during cleanup"); return null;
    }
    if (name == "") name = "#00";
    base := name;
    index := 0;
    for (i := 0; i < len(t.children); i++) {
        if (t.children[i] == name) { index++; name = base + "#" + io.Sprint(index); i = -1; }
    }
    t.children.append(name);
    t.gate.Unlock();
    child := new(T);
    child.name = t.name + "/" + name;
    child.parent = t;
    return child;
}
func (t *T) Run(name string, callback func(*T)) bool {
    child := t.newChild(name);
    if (child == null) return false;
    release(t);
    id := threads.Spawn(func() { execute(child, callback); });
    t.gate.Lock(); t.pending.append(childTask{id, child}); t.gate.Unlock();
    for (;;) {
        child.gate.Lock(); ready := child.signaled; child.gate.Unlock();
        if (ready) break;
        time.Sleep(time.Millisecond);
    }
    acquire(t);
    return !child.Failed();
}
// Parallel pauses the calling test; it does not create a named callback.
func (t *T) Parallel() {
    if (threads.CurrentID() != t.owner) panic "Parallel must run on the test's own thread";
    t.gate.Lock(); invalid := t.parallel || t.cleaning; t.parallel = true; t.gate.Unlock();
    if (invalid) panic "Parallel called twice or during cleanup";
    pause := now();
    event("pause", t.name, "", pause - t.started - t.paused);
    release(t);
    t.gate.Lock(); t.signaled = true; t.gate.Unlock();
    for (;;) {
        ready := false;
        if (t.parent == null) { poolGate.Lock(); ready = serialDone; poolGate.Unlock(); }
        else { t.parent.gate.Lock(); ready = t.parent.childrenReady; t.parent.gate.Unlock(); }
        if (ready) break;
        time.Sleep(time.Millisecond);
    }
    acquire(t);
    t.paused += now() - pause;
    event("cont", t.name, "", now() - t.started - t.paused);
}
// Runner hooks: register every function before starting a bounded shared pool.
func Start() {
    failures = 0; serialDone = false; testNames = {}; jobs = {}; workerCount = 16;
    args := os.Args();
    if (len(args) == 3 && args[1] == "--ocean-test-workers") {
        workerCount = io.ParseInt(args[2]).unwrap();
        if (workerCount < 1) panic "test worker count must be positive";
    }
    event("start", "", "", 0);
}
func RunTest(name string, callback func(*T)) {
    base := name;
    index := 0;
    for (i := 0; i < len(testNames); i++) {
        if (testNames[i] == name) { index++; name = base + "#" + io.Sprint(index); i = -1; }
    }
    testNames.append(name);
    jobs.append(testJob{name, callback});
}
func Finish() int {
    tasks := childTask[]{};
    for (i := 0; i < len(jobs); i++) {
        job := jobs[i];
        t := new(T); t.name = job.name; t.parent = null;
        id := threads.Spawn(func() { execute(t, job.callback); });
        tasks.append(childTask{id, t});
        for (;;) {
            t.gate.Lock(); ready := t.signaled; t.gate.Unlock();
            if (ready) break;
            time.Sleep(time.Millisecond);
        }
    }
    poolGate.Lock(); serialDone = true; poolGate.Unlock();
    for (i := 0; i < len(tasks); i++) releaseChild(tasks[i]);
    event("complete", "", "", 0);
    return failures > 0 ? 1 : 0;
}
