package tui;
import "testing";
import "term";
func TestFrameClippingAndStyles(t *testing.T) {
    text, rows := frame("\x1b[31mab界cd\x1b[0m\nnext\nignored",term.Size{Width:5,Height:2});
    if (text != "\x1b[31mab界\x1b[0m\r\nnext\x1b[0m" || rows != 1) t.Fatal("frame changed clipping, UTF-8, styles, or height limits");
    text, rows = frame("a\tb\x1b[2J!",term.Size{Width:12,Height:1});
    if (text != "a       b!\x1b[0m" || rows != 0) t.Fatal("frame changed tabs or control sanitization");
}
